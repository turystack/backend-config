{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/scripts/**/*",
			"**/vitest.config.ts",
			"**/vitest.e2e.config.ts",
			"**/drizzle.config.ts",
			"!**/dist",
			"!**/coverage*",
			"!**/drizzle"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 80,
		"formatWithErrors": false
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[
								":NODE:"
							],
							":BLANK_LINE:",
							[
								":PACKAGE:",
								"!@turystack/**",
								"!@repo/**"
							],
							":BLANK_LINE:",
							[
								"@turystack/**"
							],
							":BLANK_LINE:",
							[
								"@repo/**"
							],
							":BLANK_LINE:",
							[
								"@/database/**"
							],
							":BLANK_LINE:",
							[
								"@/support/**"
							],
							":BLANK_LINE:",
							[
								"@/adapters/**"
							],
							":BLANK_LINE:",
							[
								"@/domains/**"
							],
							":BLANK_LINE:",
							[
								"@/controllers/**"
							],
							":BLANK_LINE:",
							[
								"@/exceptions",
								"@/env.schema"
							],
							":BLANK_LINE:",
							[
								":PATH:"
							]
						]
					}
				},
				"useSortedKeys": {
					"level": "on",
					"options": {}
				},
				"useSortedProperties": {
					"level": "on",
					"options": {}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useBlockStatements": "error",
				"noNonNullAssertion": "warn"
			},
			"complexity": {
				"noStaticOnlyClass": "off",
				"noBannedTypes": "off"
			},
			"correctness": {
				"noUnusedFunctionParameters": "warn"
			}
		}
	},
	"json": {
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		}
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		},
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"trailingCommas": "all",
			"expand": "always"
		}
	},
	"overrides": [
		{
			"includes": [
				"**/src/domains/**",
				"**/libs/domains/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@nestjs/**"
										],
										"message": "ARC-LAY-2: the domain imports no framework."
									},
									{
										"group": [
											"@/controllers/**",
											"@/adapters/**"
										],
										"message": "ARC-LAY-2: the domain imports no transport and no adapter."
									},
									{
										"group": [
											"@/database/**",
											"@repo/database/**",
											"drizzle-orm",
											"drizzle-orm/**"
										],
										"message": "ARC-LAY-2: the domain imports no persistence."
									},
									{
										"group": [
											"express",
											"fastify",
											"@aws-sdk/**"
										],
										"message": "ARC-LAY-2: the domain imports no infrastructure client."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/src/controllers/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/database/**",
											"@repo/database/**",
											"drizzle-orm",
											"drizzle-orm/**"
										],
										"message": "ARC-LAY-3: the delivery boundary does not import persistence directly."
									},
									{
										"group": [
											"**/*.repository.js",
											"**/*.repository.ts"
										],
										"message": "ARC-LAY-3: the delivery boundary calls a use-case, never a repository."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/src/adapters/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/domains/**",
											"@repo/domains/**"
										],
										"message": "ARC-LAY-8 / ADP-3: an adapter knows no domain — the domain declares the port, the app injects the implementation."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/*.json"
			],
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": {
							"level": "off",
							"options": {}
						},
						"useSortedProperties": {
							"level": "off",
							"options": {}
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/*.schema.ts",
				"**/*.schemas.ts",
				"**/*.entity.ts",
				"**/*.types.ts"
			],
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": {
							"level": "off",
							"options": {}
						},
						"useSortedProperties": {
							"level": "off",
							"options": {}
						}
					}
				}
			}
		}
	]
}
